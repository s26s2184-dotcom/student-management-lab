# Copy this file to .env and adjust if needed.
# These are DUMMY lab credentials. Do not reuse anywhere real.

MYSQL_ROOT_PASSWORD=lab_root_pw_change_me
MYSQL_DATABASE=student_management_lab
MYSQL_USER=labapp_user
MYSQL_PASSWORD=lab_app_pw_change_me

# Which app to run: "vulnerable" or "secure"
APP_MODE=vulnerable

# Bind address for the web app (localhost only — do not change for this lab)
APP_BIND=127.0.0.1
APP_PORT=8080
